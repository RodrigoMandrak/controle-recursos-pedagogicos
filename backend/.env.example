# Modelo do arquivo .env (copie para backend/.env e preencha).
# O preparar_banco.py cria o .env sozinho. Nunca coloque valores reais neste arquivo.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=controle_recursos
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
# no banco da nuvem (Neon) use: require
DB_SSLMODE=

# chave da sessao (texto aleatorio e longo)
SECRET_KEY=troque_por_um_texto_aleatorio

# horario usado em "hoje", "agora" e nos logs
FUSO_HORARIO=America/Sao_Paulo

# endereco do site, usado no link de recuperacao de senha
FRONTEND_URL=http://localhost:8080

# Gmail que envia a recuperacao de senha (senha de app do Google, nao a senha normal)
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
